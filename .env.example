# Use credentials created in https://demo.kalshi.co/ for this demo endpoint.
KALSHI_API_KEY_ID=your-demo-api-key-id

# Keep the private key outside this repository and use an absolute path.
KALSHI_PRIVATE_KEY_PATH=C:/secure/path/kalshi-demo-private-key.pem

KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_REQUEST_TIMEOUT_SECONDS=10

# Current authenticated WebSocket endpoint for the demo environment.
KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

# Engine safety settings. DRY_RUN=false submits IOC orders to demo only.
# Production hosts are rejected and each submitted opportunity is capped at $10.
MAX_COLLATERAL_CENTS=1000000
DRY_RUN=true
KALSHI_DATABASE_PATH=kalshi_arbitrage.db
KALSHI_SCAN_INTERVAL_SECONDS=2
KALSHI_MARKET_LIMIT=1000
